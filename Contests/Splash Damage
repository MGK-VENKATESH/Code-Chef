import sys


def solve():
    input_stream = sys.stdin.readline

    test_cases = int(input_stream())

    for _ in range(test_cases):
        target_count = int(input_stream())
        durability_list = list(map(int, input_stream().split()))

        INF_NEG = -10**9

        state_scores = {(0, 0): 0, (1, 0): 1}

        for idx in range(target_count - 1):
            next_state_scores = {}
            threshold = durability_list[idx] - 1

            for (is_targeted, prev_impact), current_total in state_scores.items():
                if is_targeted:
                    if prev_impact <= threshold:
                        state_key = (0, 0)
                        next_state_scores[state_key] = max(
                            next_state_scores.get(state_key, INF_NEG),
                            current_total,
                        )
                else:
                    state_key = (0, 0)
                    next_state_scores[state_key] = max(
                        next_state_scores.get(state_key, INF_NEG),
                        current_total,
                    )

                if is_targeted:
                    if prev_impact <= threshold:
                        state_key = (1, 1)
                        next_state_scores[state_key] = max(
                            next_state_scores.get(state_key, INF_NEG),
                            current_total + 1,
                        )

                    if prev_impact + 1 <= threshold:
                        state_key = (1, 0)
                        next_state_scores[state_key] = max(
                            next_state_scores.get(state_key, INF_NEG),
                            current_total + 1,
                        )
                else:
                    state_key = (1, 0)
                    next_state_scores[state_key] = max(
                        next_state_scores.get(state_key, INF_NEG),
                        current_total + 1,
                    )

            state_scores = next_state_scores

        max_successful_shots = 0
        final_threshold = durability_list[-1] - 1

        for (
            is_targeted,
            prev_impact,
        ), final_total in state_scores.items():
            if not is_targeted or prev_impact <= final_threshold:
                max_successful_shots = max(
                    max_successful_shots, final_total
                )

        print(max_successful_shots)


if __name__ == "__main__":
    solve()
