# cook your dish here
import sys


def solve():
    input_stream = sys.stdin.readline

    num_test_cases = int(input_stream())

    for _ in range(num_test_cases):
        array_size = int(input_stream())
        permutation = list(map(int, input_stream().split()))

        max_steps = (array_size + 1) // 2

        # Map each number to its 0-based index
        value_indices = [0] * (array_size + 1)
        for idx, val in enumerate(permutation):
            value_indices[val] = idx

        # Track bounding indices for prefix values [1..k]
        prefix_min_idx = [0] * (max_steps + 1)
        prefix_max_idx = [0] * (max_steps + 1)

        curr_min_bound = value_indices[1]
        curr_max_bound = value_indices[1]

        prefix_min_idx[1] = curr_min_bound
        prefix_max_idx[1] = curr_max_bound

        is_valid = True

        for k in range(2, max_steps + 1):
            curr_min_bound = min(curr_min_bound, value_indices[k])
            curr_max_bound = max(curr_max_bound, value_indices[k])

            prefix_min_idx[k] = curr_min_bound
            prefix_max_idx[k] = curr_max_bound

            if curr_max_bound - curr_min_bound > 2 * k - 2:
                is_valid = False

        if not is_valid:
            print(-1)
            continue

        intervals = [None] * max_steps

        start_ptr = 0
        end_ptr = array_size - 1

        intervals[max_steps - 1] = (start_ptr, end_ptr)

        # Reconstruct intervals in reverse
        for step in range(max_steps - 1, 0, -1):
            shift_left = min(2, prefix_min_idx[step] - start_ptr)
            shift_right = 2 - shift_left

            start_ptr += shift_left
            end_ptr -= shift_right

            intervals[step - 1] = (start_ptr, end_ptr)

        for l_bound, r_bound in intervals:
            print(l_bound + 1, r_bound + 1)


if __name__ == "__main__":
    solve()
