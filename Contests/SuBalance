import sys

def solve():
    data = sys.stdin.buffer.read().split()
    pos = 0
    t = int(data[pos]); pos += 1
    out = []
    for _ in range(t):
        n = int(data[pos]); pos += 1
        A = list(map(int, data[pos:pos+n]))
        pos += n

        ans = None

        # 1. Look for a strict local peak: A[i-1] < A[i] > A[i+1]
        for i in range(1, n - 1):
            if A[i-1] < A[i] > A[i+1]:
                ans = (i, i + 2)  # 1-indexed L, R
                break

        # 2. Otherwise use a monotonic stack to find equal values
        #    with nothing bigger between them
        if ans is None:
            stack = []  # (value, 0-based index)
            for j in range(n):
                x = A[j]
                while stack and stack[-1][0] < x:
                    stack.pop()
                if stack and stack[-1][0] == x:
                    ans = (stack[-1][1] + 1, j + 1)
                    break
                stack.append((x, j))

        out.append(f"{ans[0]} {ans[1]}" if ans else "-1")

    sys.stdout.write('\n'.join(out) + '\n')

solve()
